apiVersion: apps/v1
kind: Deployment
metadata:
  name: devmind-gateway-__NAME__
  namespace: devmind
spec:
  replicas: 1
  strategy:
    type: Recreate
  selector:
    matchLabels:
      app: devmind-gateway-__NAME__
  template:
    metadata:
      labels:
        app: devmind-gateway-__NAME__
    spec:
      containers:
        - name: devmind-gateway
          image: __REGISTRY__/devmind-gateway:test
          imagePullPolicy: Always
          ports:
            - containerPort: __PORT__
          env:
            - name: DEVMIND_CLOUD_URL
              value: __CLOUD_URL__
            - name: DEVMIND_ORCHESTRATOR_URL
              value: __ORCH_URL__
            - name: DEVMIND_CLIENT_ID
              value: __CLIENT__
            - name: DEVMIND_PORT
              value: "__PORT__"
            - name: OTEL_EXPORTER_OTLP_ENDPOINT
              value: __OTEL_ENDPOINT__
          envFrom:
            - configMapRef:
                name: devmind-test-knobs
          resources:
            requests:
              cpu: "200m"
              memory: "1Gi"
            limits:
              cpu: "1"
              memory: "2Gi"
          readinessProbe:
            httpGet:
              path: /health
              port: __PORT__
            initialDelaySeconds: 30
            periodSeconds: 10
            failureThreshold: 6
          livenessProbe:
            httpGet:
              path: /health
              port: __PORT__
            initialDelaySeconds: 60
            periodSeconds: 10
            failureThreshold: 6
---
apiVersion: v1
kind: Service
metadata:
  name: devmind-gateway-__NAME__
  namespace: devmind
spec:
  type: LoadBalancer
  selector:
    app: devmind-gateway-__NAME__
  ports:
    - port: __PORT__
      targetPort: __PORT__
